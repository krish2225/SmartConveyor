rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ConveyorBelt-PdM (SIH 2026) Devices Root Collection
    match /devices/{deviceId} {
      allow read, write: if true;

      // 1. Live Sensor Data: devices/{deviceId}/live/latest
      match /live/{docId} {
        allow read, write: if true;
      }

      // 2. Sensor History: devices/{deviceId}/history/{timestamp}
      match /history/{docId} {
        allow read, write: if true;
      }

      // 3. ML Predictions: devices/{deviceId}/predictions/latest
      match /predictions/{docId} {
        allow read, write: if true;
      }

      // 4. Alerts: devices/{deviceId}/alerts/{alertId}
      match /alerts/{alertId} {
        allow read, write: if true;
      }

      // 5. Camera Snapshots: devices/{deviceId}/snapshots/latest
      match /snapshots/{docId} {
        allow read, write: if true;
      }
    }

    // Helper functions for facilities collection
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SITE_ADMIN';
    }

    // Facility Telemetry & Sensor Streams
    match /facilities/{facilityId}/telemetry/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Splice Joint Status & RUL Predictions
    match /facilities/{facilityId}/joints/{jointId} {
      allow read: if true;
      allow write: if true;
    }

    // Sensor Reliability Indices
    match /facilities/{facilityId}/sensorReliability/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Computer Vision Events
    match /facilities/{facilityId}/visionEvents/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Alerts collection
    match /facilities/{facilityId}/alerts/{alertId} {
      allow read, write: if true;
    }

    // System Emergency Stop status
    match /systemStatus/{facilityId} {
      allow read, write: if true;
    }
  }
}
