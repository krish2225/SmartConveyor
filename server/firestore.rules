rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SITE_ADMIN';
    }
    
    function isOperatorOrEngineer() {
      return isAuthenticated() && (
        request.auth.token.role == 'OPERATOR' || 
        request.auth.token.role == 'MAINTENANCE_ENGINEER' || 
        request.auth.token.role == 'SITE_ADMIN'
      );
    }

    // Facility Telemetry & Sensor Streams: READ ONLY for clients (Cloud Functions writes sensor data)
    match /facilities/{facilityId}/telemetry/{docId} {
      allow read: if true;
      allow write: if false; // Only written by backend simulator / Cloud Functions
    }

    // Splice Joint Status & RUL Predictions: READ ONLY for clients
    match /facilities/{facilityId}/joints/{jointId} {
      allow read: if true;
      allow write: if false;
    }

    // Sensor Reliability Indices: READ ONLY for clients
    match /facilities/{facilityId}/sensorReliability/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Computer Vision Events: READ ONLY for clients
    match /facilities/{facilityId}/visionEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Alerts collection: Operators can acknowledge; Admins can resolve
    match /facilities/{facilityId}/alerts/{alertId} {
      allow read: if true;
      allow create: if false; // Generated by backend triggers
      allow update: if isAuthenticated() && (
        // Allow updating status to ACKNOWLEDGED or RESOLVED
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'resolvedBy', 'resolvedAt', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // System Emergency Stop status: Global read; Authorized users can initiate, Admins can clear
    match /systemStatus/{facilityId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        // Initiating e-stop allowed by all operators
        (request.resource.data.emergencyStopActive == true) ||
        // Clearing e-stop restricted to Admin
        (request.resource.data.emergencyStopActive == false && isAdmin())
      );
    }
  }
}
